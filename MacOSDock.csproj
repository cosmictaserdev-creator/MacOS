<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>MacOSDock</AssemblyName>
    <RootNamespace>MacOSDock</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Shaders/LiquidGlass.ps" />
    <None Include="Shaders/LiquidGlass.hlsl" />
  </ItemGroup>
</Project>
